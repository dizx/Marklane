<Window
    x:Class="Marklane.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Marklane">
    <Grid x:Name="Root" Background="{ThemeResource MarklaneChromeBrush}" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="32" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE70B;" FontSize="15" Foreground="#8C9F87" />
                <TextBlock Text="MARKLANE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="180" />
                <TextBlock x:Name="TitleText" Margin="20,0,0,0" Opacity="0.65" FontSize="12" Text="Untitled.md" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="Toolbar" Padding="8,0,16,2" BorderBrush="{ThemeResource MarklaneDividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <MenuBar VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New" Tag="new" Click="OnCommand">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open…" Tag="open" Click="OnCommand">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="Recent files" AutomationProperties.AutomationId="RecentFilesMenu">
                        <MenuFlyoutItem Text="No recent files" IsEnabled="False" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save" Tag="save" Click="OnCommand">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save as…" Tag="saveAs" Click="OnCommand">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Undo" Tag="undo" Click="OnCommand" />
                    <MenuFlyoutItem Text="Redo" Tag="redo" Click="OnCommand" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Find / replace…" Tag="find" Click="OnCommand" />
                </MenuBarItem>
                <MenuBarItem Title="Format">
                    <MenuFlyoutItem Text="Bold" Tag="bold" Click="OnCommand" />
                    <MenuFlyoutItem Text="Italic" Tag="italic" Click="OnCommand" />
                    <MenuFlyoutItem Text="Inline code" Tag="code" Click="OnCommand" />
                    <MenuFlyoutItem Text="Link" Tag="link" Click="OnCommand" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Heading" Tag="heading" Click="OnCommand" />
                    <MenuFlyoutItem Text="Bullet list" Tag="bullet" Click="OnCommand" />
                    <MenuFlyoutItem Text="Task list" Tag="task" Click="OnCommand" />
                    <MenuFlyoutItem Text="Quote" Tag="quote" Click="OnCommand" />
                    <MenuFlyoutItem Text="Code block" Tag="fence" Click="OnCommand" />
                    <MenuFlyoutItem Text="Table" Tag="table" Click="OnCommand" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Toggle source    Ctrl+/" Tag="source" Click="OnCommand" />
                    <MenuFlyoutItem Text="Toggle outline" Tag="outline" Click="OnCommand" />
                    <MenuFlyoutItem Text="Focus mode    Ctrl+Shift+F" Tag="focus" Click="OnCommand" />
                    <ToggleMenuFlyoutItem x:Name="NightModeMenu" Text="Night mode" Tag="theme" Click="OnCommand" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About Marklane" Tag="about" Click="OnCommand" />
                </MenuBarItem>
            </MenuBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Tag="open" Click="OnCommand" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Open document (Ctrl+O)" AutomationProperties.Name="Open document"><FontIcon Glyph="&#xE8E5;" FontSize="16" /></Button>
                <Button Tag="save" Click="OnCommand" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"><FontIcon Glyph="&#xE74E;" FontSize="16" /></Button>
                <ToggleButton x:Name="SourceButton" Content="&lt;/&gt;" Tag="source" Click="OnCommand" ToolTipService.ToolTip="Markdown source (Ctrl+/)" AutomationProperties.Name="Markdown source" />
                <Button Tag="focus" Click="OnCommand" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Focus mode (Ctrl+Shift+F); Escape to exit" AutomationProperties.Name="Focus mode"><FontIcon Glyph="&#xE740;" FontSize="16" /></Button>
                <Button x:Name="ThemeButton" Tag="theme" Click="OnCommand" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Switch to night mode" AutomationProperties.Name="Switch to night mode"><FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="16" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="Sidebar" Padding="12,24,12,12" Background="{ThemeResource MarklaneSidebarBrush}" BorderBrush="{ThemeResource MarklaneDividerBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="12,0,0,20" Spacing="6">
                    <TextBlock Text="YOUR DOCUMENT" FontSize="10" CharacterSpacing="130" Opacity="0.5" />
                    <TextBlock Text="Outline" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <ListView x:Name="OutlineList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="OnHeadingClick" SelectionMode="Single" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="13" Padding="0,5" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Margin="12,16,0,4" Text="One thought at a time." FontSize="11" Opacity="0.45" />
            </Grid>
            <Grid Grid.Column="1">
                <WebView2 x:Name="Editor" />
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440">
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="28" Height="28" />
                    <TextBlock x:Name="LoadingText" Text="Preparing your writing space…" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Grid>
        <Grid x:Name="StatusBar" Grid.Row="3" Padding="20,0" BorderBrush="{ThemeResource MarklaneDividerBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock x:Name="SaveStatus" Text="Ready" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="ModeStatus" Text="Live preview" FontSize="11" Opacity="0.5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock x:Name="WordStatus" Text="0 words" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="EncodingStatus" Text="UTF-8 · CRLF" FontSize="11" Opacity="0.5" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
